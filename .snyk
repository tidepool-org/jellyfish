ignore:
  SNYK-JS-INFLIGHT-6095116:
    - '*':
        reason: >-
          No remediation available: inflight is unmaintained and every glob
          release that dropped it changed the API its dependants use.
          Production dependency via bunyan, but only for the 'rotating-file'
          logger, which is not in use. Development dependency via jshint and
          mocha.
        expires: 2027-09-01
patch: {}
